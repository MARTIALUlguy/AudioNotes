# Configuration Environment pour AudioNote PWA

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# PWA Configuration
VITE_PWA_NAME="AudioNote"
VITE_PWA_SHORT_NAME="AudioNote"
VITE_PWA_DESCRIPTION="Application d'enregistrement audio PWA"
VITE_PWA_THEME_COLOR="#1a1a2e"
VITE_PWA_BG_COLOR="#1a1a2e"

# Feature Flags
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_BACKGROUND_SYNC=true
VITE_ENABLE_COMPRESSION=false
VITE_ENABLE_ANALYTICS=false

# N8N Webhook URLs
VITE_N8N_FORM_URL=https://votre-instance-n8n/webhook/audio-form
VITE_N8N_WEBHOOK_URL=https://n8n.srv770518.hstgr.cloud/webhook/audio-upload
VITE_N8N_STATUS_URL=https://n8n.srv770518.hstgr.cloud/webhook/audio-status

# Audio Configuration
VITE_AUDIO_SAMPLE_RATE=44100
VITE_AUDIO_CHANNELS=1
VITE_AUDIO_BITRATE=128000
VITE_AUDIO_FORMAT=webm

# Storage Configuration
VITE_MAX_STORAGE_SIZE=52428800
VITE_CHUNK_SIZE=1048576

# Debug
VITE_DEBUG_MODE=true
VITE_VERBOSE_LOGS=false

# Environment
NODE_ENV=development
