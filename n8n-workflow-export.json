{
  "name": "AudioNote Processing Workflow",
  "nodes": [
    {
      "parameters": {
        "path": "audio-upload",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-post",
      "name": "Webhook POST - Audio Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "recordingId",
              "value": "={{ $json.body.id }}"
            },
            {
              "name": "createdAt",
              "value": "={{ $json.body.createdAt }}"
            },
            {
              "name": "mimeType",
              "value": "={{ $json.body.mimeType }}"
            },
            {
              "name": "audioData",
              "value": "={{ $json.body.audio }}"
            }
          ]
        }
      },
      "id": "set-variables",
      "name": "Extract Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "file",
        "operation": "upload",
        "folderId": {
          "mode": "list",
          "value": ""
        },
        "fileName": "={{ $variables.recordingId }}.wav",
        "binaryData": true,
        "fileContent": "={{ $variables.audioData }}"
      },
      "id": "google-drive-upload",
      "name": "Google Drive - Upload Audio",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [650, 300],
      "credentials": {
        "googleDriveOAuth2Api": "google-drive-oauth2"
      }
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "resource": "audio",
        "operation": "transcribe",
        "binaryPropertyName": "data",
        "model": "whisper-1"
      },
      "id": "openai-whisper",
      "name": "OpenAI - Whisper Transcription",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [850, 300],
      "credentials": {
        "openAiApi": "openai-api-key"
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "transcript",
              "value": "={{ $json.text }}"
            }
          ]
        }
      },
      "id": "extract-transcript",
      "name": "Extract Transcript",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "resource": "message",
        "operation": "create",
        "model": "gpt-4o-mini",
        "messages": {
          "messageUi": [
            {
              "contentType": "text",
              "role": "system",
              "content": "Tu es un assistant qui résume des conversations. Génère un résumé concis en français en 3-5 phrases."
            },
            {
              "contentType": "text",
              "role": "user",
              "content": "={{ $variables.transcript }}"
            }
          ]
        },
        "options": {}
      },
      "id": "openai-chat",
      "name": "OpenAI - Chat Summarization",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [1250, 300],
      "credentials": {
        "openAiApi": "openai-api-key"
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "summary",
              "value": "={{ $json.choices[0].message.content }}"
            }
          ]
        }
      },
      "id": "extract-summary",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "id",
              "value": "={{ $variables.recordingId }}"
            },
            {
              "name": "transcript",
              "value": "={{ $variables.transcript }}"
            },
            {
              "name": "summary",
              "value": "={{ $variables.summary }}"
            },
            {
              "name": "status",
              "value": "done"
            },
            {
              "name": "processedAt",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        }
      },
      "id": "set-results",
      "name": "Set - Store Results",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "body": "{\"success\": true, \"id\": \"={{ $json.id }}\", \"message\": \"Audio processed successfully\"}"
      },
      "id": "response-success",
      "name": "Return Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1850, 300]
    },
    {
      "parameters": {
        "path": "audio-status/:id",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-get",
      "name": "Webhook GET - Audio Status",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 600]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "statusId",
              "value": "={{ $json.routeData.id }}"
            }
          ]
        }
      },
      "id": "extract-status-id",
      "name": "Extract Status ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [450, 600]
    },
    {
      "parameters": {
        "body": "{\"status\": \"{{ $variables.statusId === $json.id ? 'completed' : 'processing' }}\", \"id\": \"{{ $variables.statusId }}\", \"summary\": \"{{ $variables.statusId === $json.id ? $json.summary : null }}\", \"transcript\": \"{{ $variables.statusId === $json.id ? $json.transcript : null }}\"}"
      },
      "id": "response-status",
      "name": "Return Status Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 600]
    }
  ],
  "connections": {
    "webhook-post": {
      "main": [
        [
          {
            "node": "set-variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "set-variables": {
      "main": [
        [
          {
            "node": "google-drive-upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "google-drive-upload": {
      "main": [
        [
          {
            "node": "openai-whisper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "openai-whisper": {
      "main": [
        [
          {
            "node": "extract-transcript",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "extract-transcript": {
      "main": [
        [
          {
            "node": "openai-chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "openai-chat": {
      "main": [
        [
          {
            "node": "extract-summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "extract-summary": {
      "main": [
        [
          {
            "node": "set-results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "set-results": {
      "main": [
        [
          {
            "node": "response-success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "webhook-get": {
      "main": [
        [
          {
            "node": "extract-status-id",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "extract-status-id": {
      "main": [
        [
          {
            "node": "response-status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "audionote-processing",
  "meta": {
    "description": "AudioNote N8N Workflow - Process audio files with Whisper and ChatGPT",
    "author": "AudioNote",
    "version": "1.0.0"
  }
}
